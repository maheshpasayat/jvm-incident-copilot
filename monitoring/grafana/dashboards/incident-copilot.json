{
  "title": "Incident Copilot",
  "uid": "incident-copilot",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "Analyses (total)", "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "expr": "sum(copilot_analyses_total)" } ]
    },
    {
      "type": "stat", "title": "Findings (total)", "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "expr": "sum(copilot_findings_total)" } ]
    },
    {
      "type": "timeseries", "title": "Findings by rule", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [ { "expr": "sum by (rule) (copilot_findings_total)", "legendFormat": "{{rule}}" } ]
    },
    {
      "type": "timeseries", "title": "HTTP requests per second", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [ { "expr": "sum by (uri) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{uri}}" } ]
    },
    {
      "type": "timeseries", "title": "JVM heap used (MB)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [ { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / 1024 / 1024" } ]
    },
    {
      "type": "stat", "title": "AI explanations: available vs not", "gridPos": { "h": 5, "w": 12, "x": 0, "y": 16 },
      "targets": [ { "expr": "sum by (available) (copilot_ai_explanations_total)", "legendFormat": "available={{available}}" } ]
    }
  ]
}
